WHISPER_MODEL=small.en
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=auto
WHISPER_BEAM_SIZE=5
WHISPER_CPU_THREADS=0
WHISPER_VAD_FILTER=true

FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
TEMP_DIR=/tmp/keyway
MODEL_CACHE_DIR=/models
OUTPUT_DIR=/output

# Analysis backend options: openai | ollama
ANALYSIS_BACKEND=openai
ANALYSIS_BASE_URL=https://api.openai.com/v1
ANALYSIS_API_KEY=
ANALYSIS_MODEL=gpt-4.1-mini
# For Ollama:
# ANALYSIS_BACKEND=ollama
# ANALYSIS_BASE_URL=http://localhost:11434
# ANALYSIS_MODEL=llama3.2:latest
# ANALYSIS_API_KEY=
ANALYSIS_TIMEOUT_SECONDS=120
ANALYSIS_MAX_CHARACTERS=120000

# Microsoft Graph (only for POST /v1/process/sharepoint). Entra app registration
# with application permission Sites.Read.All or Files.Read.All; inject the secret,
# never commit it.
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_BASE_URL=https://graph.microsoft.com/v1.0
GRAPH_TIMEOUT_SECONDS=300

# JSON array. HTTP local-path requests are rejected when this is empty.
LOCAL_SOURCE_ROOTS=["/media"]
MAX_SOURCE_BYTES=53687091200
PROCESS_TIMEOUT_SECONDS=7200
MAX_CONCURRENT_JOBS=1
LOG_LEVEL=INFO
